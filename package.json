{
  "name": "maximushub-print-client",
  "version": "1.0.7",
  "description": "MaximusHub Print Client — impressão local via MQTT",
  "author": "MaximusHub",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node src/fila-impressao.test.js && node src/pdf-etiqueta.test.js && node src/preparo-impressora.test.js",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "packagePublish": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.4",
    "mqtt": "^5.7.3",
    "pdf-lib": "^1.17.1",
    "pdf-to-printer": "^5.1.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.maximushub.printclient",
    "productName": "MaximusHub Print Client",
    "artifactName": "MHubPrintClient-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "MaximusHub Print Client"
    },
    "publish": {
      "provider": "github",
      "owner": "leorobaskievicz",
      "repo": "maximus-printer-client",
      "releaseType": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!src/**/*.test.js",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ]
  }
}
